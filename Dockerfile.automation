# ==============================================================================
# OmniSupply Automation Services Dockerfile (Celery Worker & Celery Beat)
#
# Build:
#   docker build -f Dockerfile.automation -t omnisupply-automation:latest .
#
# Required Environment Variables:
#   - CELERY_APP (default: src.automation.celery_app)
#   - CELERY_BROKER_URL (default: redis://redis:6379/0)
#   - CELERY_RESULT_BACKEND (default: redis://redis:6379/0)
#   - DATABASE_URL (PostgreSQL connection string)
# ==============================================================================

FROM python:3.11-slim AS builder

WORKDIR /app

# Install system utilities needed for building and health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install uv from official binary
COPY --from=ghcr.io/astral-sh/uv:0.5.21 /uv /uvx /bin/

# Copy dependency specifications
COPY pyproject.toml uv.lock* ./

# Install dependencies into virtual environment
ENV UV_PROJECT_ENVIRONMENT="/app/.venv"
RUN uv sync --frozen --no-dev || uv sync --no-dev

# Final runtime image
FROM python:3.11-slim AS runner

WORKDIR /app

# Create non-root system user and group
RUN groupadd -g 10001 omnisupply && \
    useradd -u 10001 -g omnisupply -s /bin/bash -m omnisupply

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app"

# Copy virtualenv and project source
COPY --from=builder --chown=omnisupply:omnisupply /app/.venv /app/.venv
COPY --chown=omnisupply:omnisupply . /app

# Ensure schedule directory exists and is writable by non-root user
RUN mkdir -p /app/run /tmp/celery && \
    chown -R omnisupply:omnisupply /app /tmp/celery

USER omnisupply

# Default command overridden by docker-compose for worker vs beat
CMD ["celery", "-A", "src.automation.celery_app", "worker", "--loglevel=info"]
